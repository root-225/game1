; Engine configuration for ABIDJAN RUNNER
config_version=5

[application]

config/name="Abidjan Runner"
config/description="Endless runner 3D inspiré d'Abidjan"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.09, 0.11, 0.16, 1)

[autoload]

Global="*res://scripts/global.gd"
Audio="*res://scripts/audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

